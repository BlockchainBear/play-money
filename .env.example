NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

POSTGRES_PRISMA_URL="postgresql://postgres:password@localhost:5432/playmoney?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/playmoney?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # See: https://next-auth.js.org/configuration/options#nextauth_secret

# Contact @case to get the dev resend creds, otherwise you can create your own at https://resend.com/
AUTH_RESEND_KEY=""
AUTH_RESEND_EMAIL=""

DEV_DB_SEED_EMAIL="" # Optional. Set your email for the DB seed to add data to your user account

# Optional. Set OpenAI key to auto-generate question tags
OPENAI_API_KEY=""

# Optional. Set vercel blob write token for avatar uploads
BLOB_READ_WRITE_TOKEN=""

# Near Integration (Testnet)
NEAR_RPC_URL="https://rpc.testnet.near.org"
PLATFORM_NEAR_ACCOUNT_ID="your-platform-deposit.testnet" # Account for receiving deposits
PLATFORM_NEAR_SENDER_ACCOUNT_ID="your-platform-sender.testnet" # Account for sending withdrawals
PLATFORM_NEAR_SENDER_PRIVATE_KEY="" # Private key for the sender account ( 매우 중요 - handle with extreme care)

# Platform and NEAR Asset Configuration
PLATFORM_PRIMARY_ASSET_ID="PRIMARY" # The assetId for the main platform currency used for NEAR deposits/withdrawals
NEAR_NATIVE_DECIMALS="24"          # Decimals for native NEAR (yoctoNEAR)

# NEP-141 USDC Token Configuration (Example for Testnet)
USDC_TOKEN_ACCOUNT_ID_NEAR="usdc.fakes.testnet" # NEAR account ID of the USDC NEP-141 token contract
USDC_TOKEN_DECIMALS_NEAR="6"                   # Decimals for the USDC token (usually 6)
PLATFORM_USDC_ASSET_ID="USDC"                  # Internal platform assetId for USDC
